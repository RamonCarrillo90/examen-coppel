# =============================================================================
# Plantilla de variables de entorno.
# Cópiala como ".env" (ese archivo NO se sube a Git) y ajusta los valores:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=coppel
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=gestion_tareas

# --- Autenticación ---
# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
JWT_SECRET= 
# Admin que se crea automáticamente al arrancar si no existe.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# --- Frontend ---
# Puerto de tu PC donde se abre la app (http://localhost:80).
WEB_PORT=80