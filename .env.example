# =============================================================================
# Plantilla de variables de entorno.
# Cópiala como ".env" (ese archivo NO se sube a Git) y ajusta los valores:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=coppel
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=gestion_tareas
# Puerto de tu PC donde se publica Postgres (cámbialo si ya usas el 5432).
POSTGRES_PORT=5432
